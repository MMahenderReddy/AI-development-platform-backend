# ── Server ────────────────────────────────────────────
PORT=4564
NODE_ENV=production

# ── Database ──────────────────────────────────────────
# Use a SEPARATE Atlas cluster or database name from dev
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/ai-development-prod?retryWrites=true&w=majority
REDIS_URL=redis://127.0.0.1:6379

# ── Auth ──────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=<generate-new-64-char-secret>
JWT_EXPIRES_IN=8h
# S2S key — PMS backend must send this in every request to the orchestrator
# Generate: node -e "console.log('orch-s2s-' + require('crypto').randomBytes(32).toString('hex'))"
ORCHESTRATOR_S2S_KEY=<generate-new-s2s-key>

# ── PMS integration ───────────────────────────────────
PMS_API_URL=https://<your-pms-backend-domain>
PMS_SERVICE_EMAIL=<pms-service-account-email>
PMS_SERVICE_PASSWORD=<pms-service-account-password>

# ── GitHub App ────────────────────────────────────────
GITHUB_APP_ID=5782632
GITHUB_APP_PRIVATE_KEY_PATH=/home/<user>/orchestrator/config/github/private-key.pem
GITHUB_APP_INSTALLATION_ID=182580666
GITHUB_PR_REVIEWER=MMahenderReddy
BOT_NAME=Mahender Reddy
BOT_EMAIL=mahender@tektreeinc.com

# ── GitHub OAuth ──────────────────────────────────────
GITHUB_APP_CLIENT_ID=Iv23lihvNQ8QPOPeMivM
GITHUB_APP_CLIENT_SECRET=dd707144f9cac46d89331d0c85743fe4b086f188
# Public URL of THIS orchestrator (used as OAuth callback base)
ORCHESTRATOR_PUBLIC_URL=https://<your-orchestrator-domain-or-ip:4564>

# ── OpenAI ────────────────────────────────────────────
OPENAI_API_KEY=<your-openai-key>
OPENAI_MODEL=gpt-4.1
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.2

# ── Workspace ─────────────────────────────────────────
ORCHESTRATOR_WORKSPACE_DIR=/home/<user>/orchestrator/workspaces
ORCHESTRATOR_JOB_TIMEOUT_MS=600000
MAX_TASKS_PER_MEMBER_PER_DAY=50
GITHUB_AUTO_MERGE_NO_CI=true

# ── CORS ──────────────────────────────────────────────
# Your PMS frontend production URL
CORS_ORIGIN=https://<your-pms-frontend-domain>
