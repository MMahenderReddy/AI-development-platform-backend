# ── Server ──────────────────────────────────────────────────────────────────
PORT=4564
NODE_ENV=development

# ── MongoDB (Atlas or local) ─────────────────────────────────────────────────
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/orchestrator_db
# Local:  mongodb://localhost:27017/orchestrator_db
MONGODB_URI=mongodb://localhost:27017/orchestrator_db

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local (Memurai on Windows or native Redis):  redis://localhost:6379
# Cloud (Upstash free tier):                   rediss://default:<pass>@<host>.upstash.io:6379
REDIS_URL=redis://localhost:6379

# ── Orchestrator Auth ─────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_min_64_chars
JWT_EXPIRES_IN=8h

# ── PMS Service Account ───────────────────────────────────────────────────────
PMS_API_URL=http://localhost:4563
PMS_SERVICE_EMAIL=ai-orchestrator@yourcompany.com
PMS_SERVICE_PASSWORD=CHANGE_ME

# ── GitHub App ────────────────────────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./github-app-private-key.pem
GITHUB_APP_INSTALLATION_ID=

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.2

# ── Workspace (where repos are cloned) ───────────────────────────────────────
ORCHESTRATOR_WORKSPACE_DIR=./workspaces
ORCHESTRATOR_JOB_TIMEOUT_MS=600000

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3416
