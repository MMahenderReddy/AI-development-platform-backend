# ── Server ──────────────────────────────────────────────────────────────────
PORT=4564
NODE_ENV=development

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Separate database from PMS — do NOT share the PMS database
MONGODB_URI=mongodb://localhost:27017/orchestrator_db

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Orchestrator Auth (separate JWT secret from PMS) ─────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_min_64_chars
JWT_EXPIRES_IN=8h

# ── PMS Service Account ───────────────────────────────────────────────────────
# A dedicated PMS user (role: Lead, 2FA OFF) created manually by your PMS Admin.
# The orchestrator will call POST /api/auth/login with these credentials.
# Never commit these values to source control.
PMS_API_URL=http://localhost:4563
PMS_SERVICE_EMAIL=ai-orchestrator@yourcompany.com
PMS_SERVICE_PASSWORD=CHANGE_ME

# ── GitHub App (Orchestrator) ─────────────────────────────────────────────────
# Register a NEW GitHub App (separate from the PMS GitHub App) with:
#   - Contents: Read & Write
#   - Pull requests: Read & Write
#   - Metadata: Read (required)
# Install the app on the target repos.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./github-app-private-key.pem
GITHUB_APP_INSTALLATION_ID=

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.2

# ── Job Execution ─────────────────────────────────────────────────────────────
# "process" (default, no Docker required) or "docker" (recommended for production)
ORCHESTRATOR_SANDBOX_MODE=process
ORCHESTRATOR_JOB_TIMEOUT_MS=600000
# Base directory for temporary job workspaces
ORCHESTRATOR_WORKSPACE_DIR=./workspaces

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3416
